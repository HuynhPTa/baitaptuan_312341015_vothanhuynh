@page
@model CartModel
@{ ViewData["Title"] = "Giỏ hàng"; }

<h1 class="page-title">Giỏ hàng <small>(@Model.ItemCount sản phẩm)</small></h1>

@if (Model.Lines.Count == 0)
{
    <div class="empty">
        <div class="empty-icon">🛒</div>
        <p>Giỏ hàng của bạn đang trống.</p>
        <a class="btn-primary-lg" asp-page="/Index">Đi mua sắm</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="cart-card">
                @foreach (var line in Model.Lines)
                {
                    <div class="cart-row">
                        <a class="cart-thumb" asp-page="/Details" asp-route-id="@line.Product.Id">
                            @if (!string.IsNullOrEmpty(line.Product.ImageUrl))
                            {
                                <img src="@line.Product.ImageUrl" alt="@line.Product.Name" />
                            }
                            else
                            {
                                <span>@line.Product.Emoji</span>
                            }
                        </a>
                        <div class="cart-info">
                            <a class="cart-name" asp-page="/Details" asp-route-id="@line.Product.Id">@line.Product.Name</a>
                            <div class="text-muted small">@line.Product.Price.Vnd()</div>
                            <form method="post" asp-page-handler="Remove" asp-route-id="@line.Product.Id">
                                <button type="submit" class="link-danger-btn">Xóa</button>
                            </form>
                        </div>
                        <form method="post" asp-page-handler="Update" asp-route-id="@line.Product.Id" class="cart-qty">
                            <input type="number" name="qty" value="@line.Quantity" min="0" max="@line.Product.Stock"
                                   class="form-control qty-input" onchange="this.form.submit()" />
                        </form>
                        <div class="cart-sub">@line.Subtotal.Vnd()</div>
                    </div>
                }
            </div>
            <form method="post" asp-page-handler="Clear" class="mt-3">
                <button type="submit" class="btn-ghost-lg">Xóa toàn bộ giỏ</button>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="summary-card">
                <h2>Tóm tắt đơn hàng</h2>
                <div class="sum-row"><span>Tạm tính</span><span>@Model.Total.Vnd()</span></div>
                <div class="sum-row"><span>Phí vận chuyển</span><span class="text-success">Miễn phí</span></div>
                <hr />
                <div class="sum-row total"><span>Tổng cộng</span><span>@Model.Total.Vnd()</span></div>
                <form method="post" asp-page-handler="Checkout">
                    <button type="submit" class="btn-primary-lg w-100 mt-3">Đặt hàng</button>
                </form>
                <a class="btn-ghost-lg w-100 mt-2 text-center" asp-page="/Index">Tiếp tục mua sắm</a>
            </div>
        </div>
    </div>
}
