<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ADMIN ADIDAS STORE</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .admin-shell {
            display: flex;
            min-height: 100vh;
        }
        .admin-side {
            width: 260px;
            background-color: #000000;
            color: #ffffff;
            padding: 24px 20px;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }
        .admin-main {
            flex-grow: 1;
            padding: 32px;
            background-color: #ffffff;
        }
        .admin-nav a {
            display: block;
            color: #b3b3b3;
            text-decoration: none;
            padding: 10px 14px;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border-left: 3px solid transparent;
            margin-bottom: 4px;
            transition: all 0.2s;
        }
        .admin-nav a:hover {
            color: #ffffff;
            background-color: #1a1a1a;
            border-left-color: #ffffff;
        }
    </style>
</head>
<body class="admin-body">
    <div class="admin-shell">
        <!-- Sidebar phong cách thể thao Adidas -->
        <aside class="admin-side">
            <div class="mb-5">
                <a class="text-white text-decoration-none fw-black fs-5 text-uppercase tracking-wider d-flex align-items-center gap-2" asp-page="/Admin/Index">
                    <svg width="28" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="1.5,19 7,9 9,19" />
                        <polygon points="8.5,19 14,5 16,19" />
                        <polygon points="15.5,19 21,1 23,19" />
                    </svg>
                    <span>ADMIN</span>
                </a>
            </div>

            <nav class="admin-nav mb-auto">
                <a asp-page="/Admin/Index">📊 TỔNG QUAN</a>
                <a asp-page="/Admin/Products">📦 SẢN PHẨM</a>
                <a asp-page="/Create">➕ THÊM MỚI</a>
                <a asp-page="/Index">🏬 XEM CỬA HÀNG</a>
            </nav>

            <div class="admin-user pt-4 border-top border-secondary border-opacity-25">
                <div class="small text-secondary text-uppercase fw-bold" style="font-size: 0.7rem;">ĐĂNG NHẬP VỚI</div>
                <div class="fw-bold mb-3 text-uppercase small text-white">@(User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Quản trị viên")</div>
                <form method="post" asp-page="/Admin/Index" asp-page-handler="Logout">
                    <button type="submit" class="btn btn-outline-light rounded-0 text-uppercase fw-bold btn-sm w-100 py-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                        ĐĂNG XUẤT
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <section class="admin-main">
            @if (TempData["Msg"] is string msg)
            {
                <div class="alert alert-dark rounded-0 border-dark d-flex justify-content-between align-items-center mb-4" role="alert">
                    <span class="text-uppercase small fw-bold">@msg</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>