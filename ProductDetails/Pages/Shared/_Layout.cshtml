@inject ProductDetails.Services.ICartService Cart
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ADIDAS STORE</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        /* Tinh chỉnh typography & style đặc trưng Adidas */
        body {
            font-family: 'AdihausDIN', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            letter-spacing: -0.01em;
            background-color: #ffffff;
            color: #000000;
        }
        .tracking-wider { letter-spacing: 0.1em; }
        .tracking-wide { letter-spacing: 0.05em; }
        .rounded-0 { border-radius: 0 !important; }

        /* Card Hover Effect */
        .adidas-card {
            transition: all 0.2s ease;
        }
        .adidas-card:hover .adidas-img {
            transform: scale(1.05);
        }
        .adidas-img {
            transition: transform 0.4s ease;
        }
        .adidas-link:hover {
            text-decoration: underline !important;
        }
        .adidas-btn-add {
            letter-spacing: 0.08em;
            font-size: 0.8rem;
            transition: background 0.2s, color 0.2s;
        }
        .adidas-btn-add:hover:not(:disabled) {
            background-color: #333;
        }
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar -->
    <div class="bg-black text-white text-center py-1 small fw-bold text-uppercase tracking-wider" style="font-size: 0.72rem;">
        GIAO HÀNG MIỄN PHÍ CHO THÀNH VIÊN · ĐỔI TRẢ TRONG 30 NGÀY
    </div>

    <!-- Main Navigation Header -->
    <header class="border-bottom border-dark border-1 sticky-top bg-white">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <!-- Brand -->
            <a class="text-dark text-decoration-none fw-bolder fs-4 text-uppercase tracking-wide d-flex align-items-center gap-2" asp-page="/Index">
                <svg width="34" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="1.5,19 7,9 9,19" />
                    <polygon points="8.5,19 14,5 16,19" />
                    <polygon points="15.5,19 21,1 23,19" />
                </svg>
                <span>STORE</span>
            </a>

           <!-- Nav Links -->
<nav class="d-none d-md-flex gap-4 fw-bold text-uppercase small tracking-wider">
    <a class="text-dark text-decoration-none border-bottom border-2 border-dark pb-1" asp-page="/Index">SẢN PHẨM</a>
    @if (User.IsInRole("Admin"))
    {
        <!-- Chỉ ai đã đăng nhập quyền Admin mới thấy lối tắt vào Dashboard -->
        <a class="text-danger text-decoration-none pb-1" asp-page="/Admin/Index">TRANG QUẢN TRỊ</a>
    }
</nav>

            <!-- Cart Action -->
            <a class="text-dark text-decoration-none position-relative d-flex align-items-center gap-2 p-1" asp-page="/Cart">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span class="badge bg-black text-white rounded-pill px-2 py-1" style="font-size: 0.75rem;">@Cart.Count</span>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container py-4 flex-grow-1">
        @if (TempData["Msg"] is string msg)
        {
            <div class="alert alert-dark rounded-0 border-dark d-flex justify-content-between align-items-center" role="alert">
                <span class="text-uppercase small fw-bold">@msg</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Adidas Style Footer -->
    <footer class="bg-black text-white pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4 pb-4 border-bottom border-secondary border-opacity-25 small">
                <div class="col-6 col-md-3">
                    <h6 class="text-uppercase fw-bold mb-3 tracking-wider">SẢN PHẨM</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-secondary">
                        <li>Giày</li>
                        <li>Quần áo</li>
                        <li>Phụ kiện</li>
                        <li>Hàng mới về</li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="text-uppercase fw-bold mb-3 tracking-wider">HỖ TRỢ</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-secondary">
                        <li>Trợ giúp & Dịch vụ</li>
                        <li>Giao hàng & Vận chuyển</li>
                        <li>Trả hàng & Hoàn tiền</li>
                    </ul>
                </div>
                <div class="col-12 col-md-6 text-md-end d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="text-uppercase fw-bold mb-2 tracking-wider">THAM GIA CÙNG CHÚNG TÔI</h6>
                        <p class="text-secondary small">Nhận thông tin ưu đãi và các đợt phát hành độc quyền sớm nhất.</p>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary" style="font-size: 0.75rem;">
                <div>© @DateTime.Now.Year ADIDAS VIETNAM · ASP.NET CORE RAZOR PAGES</div>
                <div class="d-flex gap-3 mt-2 mt-md-0 text-uppercase">
                    <span>Chính sách bảo mật</span>
                    <span>Điều khoản sử dụng</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>